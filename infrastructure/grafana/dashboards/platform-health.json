{
 "uid": "platform-health",
 "title": "MeetClone - Platform health",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Nodes up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "up{job=\"meetclone-nodes\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Redis reachable (per node)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "app_redis_up",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Active meetings (routers)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sfu_routers",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Connected sockets",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "socketio_connected_clients",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "5xx ratio",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum by (node)(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum by (node)(rate(http_request_duration_seconds_count[5m]))",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Node draining",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sfu_draining",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "meetclone"
 ]
}