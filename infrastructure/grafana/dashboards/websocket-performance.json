{
 "uid": "websocket-performance",
 "title": "MeetClone - WebSocket",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Connected clients",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "socketio_connected_clients",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Connections / s",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "rate(socketio_connections_total[1m])",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Disconnects by reason / s",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum by (reason)(rate(socketio_disconnects_total[5m]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Events / s (top)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "topk(10, sum by (event)(rate(socketio_events_total[1m])))",
     "legendFormat": "{{event}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Rate-limited events / s",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum by (node)(rate(socketio_events_rate_limited_total[5m]))",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "meetclone"
 ]
}