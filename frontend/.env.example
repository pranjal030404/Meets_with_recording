# Backend API URL (REST API base URL)
VITE_API_URL=http://localhost:5000

# Socket.IO server URL (WebSocket signaling)
# For production load-balanced setup, use the load balancer URL
# e.g., VITE_SOCKET_URL=https://meetclone.yourdomain.com
VITE_SOCKET_URL=http://localhost:5000

# ============================================
# WHITE-LABEL BRANDING
# ============================================
# Rebrand the app per deployment without code changes.
# Copy these into frontend/.env (create it from this file).

# Product name shown in navbars, landing page, auth screens, sidebar
#VITE_APP_NAME=MeetClone

# Tagline shown in the page title, footer, and landing hero
#VITE_APP_TAGLINE=Professional Video Meetings

# Custom logo image URL or /path (falls back to built-in gradient icon)
# Put your file in frontend/public/ e.g. /logo.png, then set VITE_APP_LOGO_URL=/logo.png
#VITE_APP_LOGO_URL=

# Favicon / browser-tab icon override
#VITE_APP_ICON_URL=

# Meta description for the landing page
#VITE_APP_DESCRIPTION=Professional video meetings with recording, transcripts, chat and team workspaces.

# Company name used in the copyright line (falls back to app name)
#VITE_APP_COMPANY=

# Support email shown to end users (optional)
#VITE_APP_SUPPORT_EMAIL=
