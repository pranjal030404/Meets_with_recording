# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# IDEs and editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Lock files (optional - uncomment if you want to ignore them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Production
/backend/dist
/frontend/dist

# Testing
/backend/coverage
/frontend/coverage

# Database
*.db
*.sqlite
*.sqlite3

# Uploads/Media
uploads/*
!uploads/.gitkeep

# Misc
.cache/
.parcel-cache/
.vite/

