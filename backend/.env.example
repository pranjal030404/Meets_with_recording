# ============================================
# MEETCLONE - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env and adjust for your setup
# ============================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meetclone
DB_USER=adminuser
DB_PASSWORD=Admin@hellohere

# Database Connection Pool (for high-concurrency production)
DB_POOL_MAX=50
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Superadmin Credentials (used by migration & create-admin script)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@meetclone.com
SUPERADMIN_PASSWORD=SuperAdmin@2026

# JWT Secret (generate a strong random string - CHANGE THIS IN PRODUCTION!)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Unlock every premium feature (unlimited meetings, recording, breakout, etc.)
# for all accounts without payment. Set to false to enforce plan limits again.
UNLOCK_ALL_FEATURES=true

# Server Port (keep frontend/.env BACKEND_URL in sync)
PORT=5000

# Client URL (for CORS - must match your frontend URL/port exactly)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production)
NODE_ENV=development

# ============================================
# Mediasoup SFU Configuration
# ============================================
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=  # Your public IP or domain (leave empty for local dev)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=4  # Max workers per process (capped at 8)

# ============================================
# TURN Server Configuration (Required for production behind NAT/firewall)
# ============================================
TURN_SERVER_URL=  # e.g., turn:your-turn-server.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# ============================================
# Meeting notes: FREE by default (no API key needed)
# ============================================
# Always on, offline: live captions + rule-based cleanup + extractive minutes.
#
# Free speech-to-text for recordings:  ./scripts/setup-free-transcription.sh
#   LOCAL_WHISPER_MODEL=base           # tiny (fast) | base | small (more accurate, slower)
# Free optional polish with a local LLM: install Ollama, `ollama pull qwen2.5:3b`
#   AI_PROVIDER=auto                   # auto = local Ollama if running, else rule-based (ollama|none)
#   OLLAMA_MODEL=                      # blank = pick an installed model automatically
# Words Whisper should always spell right (names, products, jargon), comma separated:
MEETING_VOCABULARY=
TRANSCRIPTION_LANGUAGE=en

# Ollama (optional local LLM)
OLLAMA_URL=http://127.0.0.1:11434

# ============================================
# EMAIL / SMTP (email verification for new signups)
# ============================================
# Credentials live here only (never in the database). Whether verification is
# actually enforced is a switch in Admin console -> Settings, so you can leave
# this filled in and still turn it on/off at any time without a restart.
# After editing these values restart the backend: pm2 restart meetclone-backend --update-env
SMTP_HOST=                         # e.g. smtp.gmail.com | smtp.zoho.in | smtp-relay.brevo.com | email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587                      # 587 (STARTTLS) or 465 (SSL)
SMTP_SECURE=false                  # true only for port 465
SMTP_USER=
SMTP_PASS=                         # Gmail: use an App Password, not your account password
MAIL_FROM="Minutes <no-reply@yourdomain.com>"
# Public URL used in the verification link (falls back to CLIENT_URL)
APP_URL=http://localhost:5173
# Product name shown in emails
APP_NAME=Minutes

# ============================================
# Redis Configuration (for Socket.IO horizontal scaling)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Scaling & Production Configuration
# ============================================
# Rate limiting: max requests per minute per IP
RATE_LIMIT_MAX=100
# Enable cluster mode (forks workers across CPU cores)
CLUSTER_ENABLED=false

# ============================================
# FILE UPLOADS (chat attachments & file sharing)
# ============================================
# Max upload size in MB (default: 50)
#FILE_SIZE_LIMIT_MB=50

# Behind nginx/Apache/a balancer: number of proxy hops to trust for client IPs (default 1 in production, 'false' to disable)
TRUST_PROXY=1

# =============================================
# Phase 2 - distributed operation
# =============================================
# REDIS_URL unset => Redis disabled (single-instance behaviour). Standalone/Sentinel Redis supported;
# Redis Cluster would need the sharded adapter (not enabled).
# REDIS_URL=redis://redis:6379
# true => startup aborts and /readyz fails without Redis (use when running >1 instance)
REDIS_REQUIRED=false
PRESENCE_TTL_MS=60000
SOCKET_MAX_BUFFER_BYTES=1000000
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# =============================================
# Phase 3 - multi-node media / meeting placement
# =============================================
# NODE_ID=sfu-1                       # unique per process (default: hostname-random)
# NODE_REGION=eu-west                 # placement prefers the joiner's region
# NODE_ZONE=eu-west-1a
# NODE_PUBLIC_URL=https://sfu-1.example.com   # how browsers reach THIS node's Socket.IO; empty = single node
# Capacity limits (unset = unconstrained). Derive from load tests; do not guess.
# SFU_MAX_CONSUMERS= SFU_MAX_PRODUCERS= SFU_MAX_TRANSPORTS= SFU_MAX_MEETINGS= SFU_MAX_BANDWIDTH_MBPS=
# SFU_MAX_CPU=0.85  SFU_MAX_MEM=0.9
# SFU_PLACEMENT_WEIGHTS={"cpu":0.35,"consumers":0.25}
# NODE_HEARTBEAT_MS=5000  NODE_TTL_MS=15000  MEETING_PLACEMENT_TTL_SEC=21600

# Selective subscription (product heuristics, NOT benchmark-derived; tune after load tests)
# SUB_SMALL_MAX=12  SUB_MEDIUM_MAX=50  SUB_PRIORITY_EXTRA=4
# SUB_{SMALL,MEDIUM,LARGE,WEBINAR}_MAX_VIDEO / _MAX_AUDIO
# Webinar mode: a manager sets meeting setting  webinar=true  (host:update-settings)

# =============================================
# Phase 4 - database / queues / storage
# =============================================
# DB_READ_HOSTS=replica1:3306,replica2:3306   # opt-in read replicas
# DB_SLOW_QUERY_MS=500
# WORKERS_IN_PROCESS=true      # false => run `npm run worker` as separate processes (needs REDIS_URL)
# Q_TRANSCRIPTION_CONCURRENCY=1 Q_TRANSCRIPTION_ATTEMPTS=2 Q_EMAIL_ATTEMPTS=5
# STORAGE_DRIVER=local          # local | s3
# S3_BUCKET= S3_REGION= S3_ENDPOINT= S3_FORCE_PATH_STYLE=false S3_PREFIX=
# (AWS credentials come from the standard AWS provider chain, never from this file)

# =============================================
# Phase 5 - TURN (see infrastructure/turn/README.md) and PM2 multi-node
# =============================================
# TURN_SECRET=            # same as coturn static-auth-secret; credentials are issued per user, expiring
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_TTL_SEC=3600
# STUN_URLS=stun:stun.l.google.com:19302
# Multi-node: see ecosystem.multinode.config.cjs (NODES_PER_HOST, HOST_ID, NODE_PUBLIC_URL_PATTERN, WORKER_PROCESSES)

# =============================================
# Phase 6 - observability
# =============================================
# METRICS_PORT=9460            # enables the INTERNAL /metrics listener (unset = off)
# METRICS_HOST=127.0.0.1       # bind a private IP only if Prometheus is on another host; never 0.0.0.0 on a public NIC
# METRICS_TOKEN=               # optional bearer token for scrapes
# LOG_FORMAT=json              # JSON lines for Loki
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318   # enables tracing via --import tracing.mjs (see ecosystem.multinode.config.cjs)
# SOCKET_EVENT_BURST=300 SOCKET_EVENT_RATE=100 SOCKET_MAX_DROPS=2000   # per-socket event limiter (heuristics)

# Live-caption translation. Default: the local Ollama model above (nothing leaves the machine; ~4-5s/line on CPU with a 3B model).
# Faster and better for Indic languages: a self-hosted LibreTranslate (captions are sent ONLY to the URL you set).
# TRANSLATE_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
# TRANSLATE_CONCURRENCY=2      # parallel translations
# TRANSLATE_MAX_QUEUE=20       # beyond this, captions show untranslated instead of lagging
# OLLAMA_KEEP_ALIVE=30m        # keeps the model loaded between captions
