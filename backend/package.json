{
  "name": "meetclone-server",
  "version": "1.0.0",
  "description": "Google Meet + Teams clone backend with WebRTC signaling",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:create": "node src/database/createdb.js",
    "migrate": "node src/database/migrate.js",
    "db:setup": "node src/database/createdb.js && node src/database/migrate.js",
    "test": "node --test --test-force-exit --test-timeout=60000 tests/*.test.js",
    "worker": "node src/workers/main.js",
    "create-admin": "node src/scripts/createSuperAdmin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.19.17",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.6.0",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.7",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.4"
  }
}
